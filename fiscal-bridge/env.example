# Copie para .env no servidor e preencha com valores reais. NUNCA versione o .env.

# Porta interna do serviço (o HTTPS público fica no proxy reverso)
PORT=8443

# Segredo compartilhado com as Edge Functions (mínimo 32 caracteres).
# Gere com: openssl rand -hex 32
FISCAL_BRIDGE_SECRET=

# Backend Lovable Cloud (mesmo projeto usado pelo app)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bucket privado onde ficam os certificados A1 (padrão do projeto)
CERT_BUCKET=certificados-fiscais

# Ambiente SEFAZ: 1 = produção, 2 = homologação
SEFAZ_TP_AMB=1

# Timeout por tentativa contra a SEFAZ (ms)
SEFAZ_TIMEOUT_MS=30000

# Modo local do agente (BRIDGE_MODE=local): as variaveis abaixo bastam
# BRIDGE_MODE=local
# PORT=8787
# AGENTE_CONFIG=./agente.json
