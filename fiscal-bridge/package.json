{
  "name": "fiscal-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Ponte mTLS entre as Edge Functions e os webservices da SEFAZ (NFeDistribuicaoDFe / NFeRecepcaoEvento4).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "node-forge": "^1.3.1",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-forge": "^1.3.11",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
